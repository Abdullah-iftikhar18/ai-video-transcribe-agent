# ==========================================
# AI Video Search & Transcription Agent - Environment Configuration
# ==========================================

# 1. SerpApi Key (for searching YouTube videos)
# Get a free key with 100 searches/month at: https://serpapi.com/
SERPAPI_API_KEY="your_serpapi_key_here"

# 2. Google Gemini API Key (for multimodal audio/video transcription)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# 3. Groq API Key (for fast Agent Tool-Calling reasoning)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"

# 4. Agent Settings
DEFAULT_LLM_PROVIDER="groq"       # Options: "groq" or "gemini"
DEFAULT_GROQ_MODEL="llama-3.3-70b-versatile"
DEFAULT_GEMINI_MODEL="gemini-2.0-flash"

# 5. Storage Settings
TRANSCRIPTS_DIR="transcripts"
